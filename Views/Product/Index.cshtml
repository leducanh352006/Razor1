@model List<Razor1.Models.Product>

@{
    ViewData["Title"] = "Danh Sách Sản Phẩm";
}

<div class="container mt-4">
    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-box-seam me-2"></i>Danh Sách Sản Phẩm
            </h2>
            <p class="text-muted mb-0">Hiển thị dữ liệu từ Model sử dụng vòng lặp <code>@@foreach</code> trong Razor View</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
            Tổng số: @Model.Count sản phẩm
        </span>
    </div>

    <!-- Bảng hiển thị danh sách sản phẩm -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="py-3 px-4 text-center" style="width: 80px;">STT</th>
                            <th scope="col" class="py-3 px-4" style="width: 100px;">Mã (Id)</th>
                            <th scope="col" class="py-3 px-4">Tên Sản Phẩm (Name)</th>
                            <th scope="col" class="py-3 px-4 text-end" style="width: 200px;">Đơn Giá (Price)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            int index = 1;
                            @* Sử dụng vòng lặp foreach để duyệtt qua danh sách sản phẩm *@
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <!-- Số thứ tự hiển thị -->
                                    <td class="text-center fw-semibold text-muted">@index</td>
                                    
                                    <!-- Hiển thị Id sản phẩm -->
                                    <td class="px-4">
                                        <span class="badge bg-secondary">#@product.Id</span>
                                    </td>
                                    
                                    <!-- Hiển thị Tên sản phẩm -->
                                    <td class="px-4 fw-medium text-dark">
                                        @product.Name
                                    </td>
                                    
                                    <!-- Hiển thị Giá sản phẩm (định dạng tiền tệ VNĐ) -->
                                    <td class="px-4 text-end fw-bold text-success">
                                        @product.Price.ToString("N0") VNĐ
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Không có sản phẩm nào trong danh sách.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
